# ==============================================================================
# UTETRA ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env
# ==============================================================================

# 1. DATABASE — MySQL
DB_URL=jdbc:mysql://localhost:3306/utetra?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# 2. JSON WEB TOKEN (JWT)
# Must be at least 256 bits (32+ characters) for HMAC-SHA-256
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000

# 3. CLOUDINARY (Media Asset Storage - Dự phòng / Chưa sử dụng)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 4. EMAIL SMTP CONFIGURATION
# Option A: Brevo SMTP Relay (Khuyên dùng)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_smtp_login
MAIL_PASSWORD=your_brevo_smtp_master_key
MAIL_FROM=your_verified_sender_email@example.com
MAIL_FROM_NAME=UTETra Zen Gallery

# Option B: Gmail SMTP
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_16_char_google_app_password
# MAIL_FROM=your_email@gmail.com
# MAIL_FROM_NAME=UTETra Zen Gallery

# 5. PAYOS PAYMENT GATEWAY (UC06 - Trả trước 100% Napas247)
# Lấy từ PayOS Dashboard (https://payos.vn/) -> Kênh thanh toán
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:8080/checkout/payos/return
PAYOS_CANCEL_URL=http://localhost:8080/checkout/payos/cancel

